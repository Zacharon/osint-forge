{
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "status",
    "passed",
    "score",
    "live_ingestion_default_respected",
    "live_ingestion_attempted",
    "checks",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string" },
    "provider": { "type": "string", "const": "mock" },
    "status": { "type": "string", "const": "needs_review" },
    "passed": { "type": "boolean", "const": false },
    "score": { "type": "number" },
    "live_ingestion_default_respected": { "type": "boolean", "const": true },
    "live_ingestion_attempted": { "type": "boolean", "const": false },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
