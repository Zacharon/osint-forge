    "source_id": { "type": "string", "minLength": 1 },
    "source_kind": {
      "type": "string",
      "enum": [
        "document",
        "web_page",
        "dataset",
        "api_response",
        "runner_artifact",
        "operator_note",
        "unknown"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "locator": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string" },
    "publisher": { "type": "string" },
    "author": { "type": "string" },
    "access_method": {
      "type": "string",
      "enum": [
        "runner_artifact",
        "operator_supplied",
        "fixture",
        "manual_review",
        "disabled_registry_proposal",
        "approved_connector"
      ]
